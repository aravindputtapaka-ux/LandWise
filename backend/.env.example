MONGODB_URI=<mongodb>
MONGODB_DB=landwise_ai_chat
MONGODB_REQUIRED=true
LOCAL_USERS_FILE=./data/users.json
# Generate two different random secrets; see START_HERE.md.
JWT_SECRET= <JWT_SECRET
OTP_HASH_SECRET=<OTP_HASH_SECRET>
JWT_EXPIRE_MINUTES=43200
# Gemini model ID must be available for your API key (without models/ prefix).
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=<TAVILY_API_KEY>
# Existing signup/password-reset flows require SMTP.
GMAIL_SMTP_USERNAME=<GMAIL_SMTP_USERNAME>
GMAIL_SMTP_APP_PASSWORD=<GMAIL_SMTP_APP_PASSWORD>